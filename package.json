{
  "name": "vofa-justfloat-engine-config",
  "version": "1.1.0",
  "private": true,
  "author": "VOFA+",
  "description": "Visual configuration and Release builder for VOFA+ JustFloat-compatible data engines.",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "verify:version": "node scripts/verify_version.js",
    "pack:win": "node scripts/package_windows.js",
    "dist": "npm run verify:version && npm run pack:win"
  },
  "devDependencies": {
    "@fluentui/svg-icons": "1.1.338",
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "license": "MIT",
  "build": {
    "appId": "plus.vofa.justfloat-engine-config",
    "productName": "VOFA+ JustFloat Engine Config",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/app-icon.png",
      "assets/app-icon.ico",
      "assets/icons/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VOFA_JustFloat_Engine_Config_x64_${version}_portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "VOFA+ JustFloat Engine Config",
      "artifactName": "VOFA_JustFloat_Engine_Config_x64_${version}_setup.${ext}"
    }
  }
}
