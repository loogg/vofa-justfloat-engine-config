{
  "name": "vofa-justfloat-engine-config",
  "version": "1.10.1",
  "private": true,
  "author": "VOFA+",
  "description": "Visual protocol configuration and Release builder for VOFA+ data engines.",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node scripts/sync_node_red.js",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "verify:version": "node scripts/verify_version.js",
    "pack:win": "node scripts/package_windows.js",
    "dist": "npm run verify:version && npm run pack:win",
    "review": "node scripts/browser_review.js --development"
  },
  "devDependencies": {
    "@fluentui/svg-icons": "1.1.338",
    "@node-red/editor-client": "5.0.8",
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "license": "MIT",
  "build": {
    "appId": "plus.vofa.justfloat-engine-config",
    "productName": "VOFA+ JustFloat Engine Config",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/app-icon.png",
      "assets/app-icon.ico",
      "assets/icons/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VOFA_JustFloat_Engine_Config_x64_${version}_portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "VOFA+ JustFloat Engine Config",
      "artifactName": "VOFA_JustFloat_Engine_Config_x64_${version}_setup.${ext}"
    }
  }
}
